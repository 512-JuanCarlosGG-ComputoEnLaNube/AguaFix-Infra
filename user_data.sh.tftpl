#!/bin/bash
# ==============================================================================
# Aprovisionamiento automático de instancia EC2 para AguaFix (Ubuntu 24.04)
# ==============================================================================
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive
LOG_FILE="/var/log/aguafix-user-data.log"
COMPOSE_DIR="${compose_dir}"

exec > >(tee -a "$LOG_FILE") 2>&1

log() {
  echo "[$(date -u '+%Y-%m-%dT%H:%M:%SZ')] $*"
}

log "Iniciando aprovisionamiento de AguaFix en Ubuntu 24.04..."

# ------------------------------------------------------------------------------
# 1. Instalar Docker Engine y Docker Compose plugin (repositorio oficial Docker)
# ------------------------------------------------------------------------------
log "Instalando dependencias base y repositorio oficial de Docker..."
apt-get -o DPkg::Lock::Timeout=120 update -y
apt-get -o DPkg::Lock::Timeout=120 install -y --no-install-recommends \
  ca-certificates \
  curl \
  gnupg

install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc

ARCH=$(dpkg --print-architecture)
CODENAME=$(. /etc/os-release && echo "$${UBUNTU_CODENAME:-$VERSION_CODENAME}")

echo "deb [arch=$ARCH signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $CODENAME stable" \
  > /etc/apt/sources.list.d/docker.list

apt-get -o DPkg::Lock::Timeout=120 update -y
apt-get -o DPkg::Lock::Timeout=120 install -y --no-install-recommends \
  docker-ce \
  docker-ce-cli \
  containerd.io \
  docker-buildx-plugin \
  docker-compose-plugin

systemctl enable --now docker

# Permitir que el usuario ubuntu ejecute docker y docker compose sin sudo (CI/CD SSH)
usermod -aG docker ubuntu

log "Docker instalado: $(docker --version)"
log "Docker Compose instalado: $(docker compose version)"

# ------------------------------------------------------------------------------
# 2. Obtener IP pública de la instancia EC2 mediante IMDSv2
# ------------------------------------------------------------------------------
log "Obteniendo IP pública de la instancia mediante IMDSv2..."
IMDS_TOKEN=""
PUBLIC_IP=""

for attempt in 1 2 3 4 5; do
  IMDS_TOKEN=$(curl -fsS -X PUT "http://169.254.169.254/latest/api/token" \
    -H "X-aws-ec2-metadata-token-ttl-seconds: 21600" || true)
  if [ -n "$IMDS_TOKEN" ]; then
    PUBLIC_IP=$(curl -fsS -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" \
      "http://169.254.169.254/latest/meta-data/public-ipv4" || true)
  fi
  if [ -n "$PUBLIC_IP" ]; then
    break
  fi
  log "Reintentando lectura de IP pública (intento $attempt/5)..."
  sleep 3
done

if [ -z "$PUBLIC_IP" ]; then
  log "ERROR: No se pudo obtener la IP pública desde IMDSv2."
  exit 1
fi

log "IP pública detectada: $PUBLIC_IP"

# ------------------------------------------------------------------------------
# 3. Actualizar registro dinámico en No-IP
# ------------------------------------------------------------------------------
log "Actualizando hostname de No-IP (${noip_hostname}) -> $PUBLIC_IP..."

IFS= read -r NOIP_USER <<'NOIP_USER_EOF'
${noip_username}
NOIP_USER_EOF

IFS= read -r NOIP_PASS <<'NOIP_PASS_EOF'
${noip_password}
NOIP_PASS_EOF

NOIP_RESPONSE=$(curl -fsS --retry 3 --retry-delay 5 \
  -A "AguaFix-EC2-Provisioner/1.0" \
  -u "$NOIP_USER:$NOIP_PASS" \
  "https://dynupdate.no-ip.com/nic/update?hostname=${noip_hostname}&myip=$PUBLIC_IP")

unset NOIP_USER NOIP_PASS

case "$NOIP_RESPONSE" in
  good*|nochg*)
    log "No-IP actualizado correctamente: $NOIP_RESPONSE"
    ;;
  *)
    log "ERROR: Respuesta inesperada de No-IP: $NOIP_RESPONSE"
    exit 1
    ;;
esac

# ------------------------------------------------------------------------------
# 4. Generar archivo de variables de entorno (.env)
# ------------------------------------------------------------------------------
log "Generando directorio $COMPOSE_DIR y archivo .env..."
mkdir -p "$COMPOSE_DIR"

cat <<'EOF' > "$COMPOSE_DIR/.env"
# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME='${db_name}'
DB_USER='${db_user}'
DB_PASSWORD='${db_password}'

# Email (SMTP)
MAIL_HOST='${mail_host}'
MAIL_PORT=${mail_port}
MAIL_USER='${mail_user}'
MAIL_PASSWORD='${mail_password}'
MAIL_FROM='${mail_from}'
MAINTENANCE_EMAIL='${maintenance_email}'

# JWT
JWT_SECRET='${jwt_secret}'

# App (puerto interno del contenedor; compose.yaml publica 80:3000)
PORT=3000
NODE_ENV=production

# AWS S3
AWS_REGION='${aws_region}'
AWS_S3_BUCKET='${aws_s3_bucket}'
AWS_ACCESS_KEY_ID='${aws_access_key_id}'
AWS_SECRET_ACCESS_KEY='${aws_secret_access_key}'
EOF

chmod 600 "$COMPOSE_DIR/.env"

# ------------------------------------------------------------------------------
# 5. Generar compose.yaml (PostgreSQL 16 + AguaFix API en 80:3000)
# ------------------------------------------------------------------------------
log "Generando $COMPOSE_DIR/compose.yaml..."

cat <<'EOF' > "$COMPOSE_DIR/compose.yaml"
services:
  postgres:
    image: postgres:16-alpine
    container_name: aguafix_db
    restart: unless-stopped
    environment:
      POSTGRES_DB: $${DB_NAME}
      POSTGRES_USER: $${DB_USER}
      POSTGRES_PASSWORD: $${DB_PASSWORD}
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s

  api:
    image: ${docker_image}
    container_name: aguafix_api
    restart: unless-stopped
    env_file:
      - .env
    environment:
      DB_HOST: postgres
      DB_PORT: "5432"
      PORT: "3000"
      NODE_ENV: production
    ports:
      - "80:3000"
    depends_on:
      postgres:
        condition: service_healthy

volumes:
  postgres_data:
EOF

# ------------------------------------------------------------------------------
# 6. Ajustar permisos, levantar contenedores y verificar arranque de la API
# ------------------------------------------------------------------------------
log "Ajustando permisos de $COMPOSE_DIR y levantando contenedores..."
chown -R ubuntu:ubuntu "$COMPOSE_DIR"
chmod 600 "$COMPOSE_DIR/.env"

cd "$COMPOSE_DIR"
docker compose pull
docker compose up -d

log "Esperando a que la API responda en http://127.0.0.1/..."
HEALTH_OK=false
for attempt in $(seq 1 24); do
  if curl -fsS http://127.0.0.1/ > /dev/null 2>&1; then
    HEALTH_OK=true
    break
  fi
  log "API aún iniciando (intento $attempt/24)..."
  sleep 5
done

if [ "$HEALTH_OK" = true ]; then
  log "AguaFix API en línea y respondiendo en http://${noip_hostname}/ (IP: $PUBLIC_IP)."
  cat <<EOF > "$COMPOSE_DIR/init.log"
status=ok
timestamp=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
public_ip=$PUBLIC_IP
hostname=${noip_hostname}
s3_bucket=${aws_s3_bucket}
EOF
  chown ubuntu:ubuntu "$COMPOSE_DIR/init.log"
else
  log "ADVERTENCIA: La API no respondió dentro del tiempo esperado. Revisa: cd $COMPOSE_DIR && docker compose logs"
  cat <<EOF > "$COMPOSE_DIR/init.log"
status=degraded
timestamp=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
public_ip=$PUBLIC_IP
hostname=${noip_hostname}
s3_bucket=${aws_s3_bucket}
EOF
  chown ubuntu:ubuntu "$COMPOSE_DIR/init.log"
  exit 1
fi
