#!/bin/bash
# ==============================================================================
# PLACEHOLDER TEMPORAL (Persona 2)
# Persona 3 reemplazará este archivo con el aprovisionamiento real:
#   - Instalar Docker y Docker Compose
#   - Obtener IP pública y actualizar No-IP
#   - Crear ${compose_dir}/compose.yaml y ${compose_dir}/.env
#   - Ejecutar: docker compose up -d
#
# Variables disponibles inyectadas desde ec2.tf (templatefile):
#   compose_dir, docker_image, noip_hostname, noip_username, noip_password,
#   db_name, db_user, db_password, mail_host, mail_port, mail_user,
#   mail_password, mail_from, maintenance_email, jwt_secret, aws_region,
#   aws_s3_bucket, aws_access_key_id, aws_secret_access_key
# ==============================================================================

set -e
mkdir -p "${compose_dir}"
chown -R ubuntu:ubuntu "${compose_dir}"
echo "Instancia inicializada correctamente. Bucket S3: ${aws_s3_bucket}" > "${compose_dir}/init.log"
